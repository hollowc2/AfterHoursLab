SCHWAB_GATEWAY_URL=https://gateway.internal.example
SCHWAB_GATEWAY_API_KEY=replace-with-issued-internal-api-key

# Earnings calendar source (independent of the gateway). Free key from finnhub.io.
FINNHUB_API_KEY=replace-with-your-finnhub-api-key

# AfterHoursLab's own isolated database on the shared TimescaleDB instance (never
# shares credentials with another app's database).
DATABASE__HOST=timescaledb
DATABASE__PORT=5432
DATABASE__NAME=afterhours_lab
DATABASE__USER=afterhours_lab
DATABASE__PASSWORD=replace-with-issued-db-password

# Optional: Telegram alert on archive-earnings failure (same pattern as Butterflyguy's
# schwab_token_keepalive.py cron job). Leave unset to rely on last_run_status.json alone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
